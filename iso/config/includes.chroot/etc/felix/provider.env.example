# Copy this file to /etc/felix/provider.env and protect it with mode 0600.
# FELIX accepts an OpenAI-compatible chat-completions endpoint.
# A local endpoint keeps thought on the machine; a remote endpoint is optional.

# Example local endpoint:
# FELIX_PROVIDER_URL=http://127.0.0.1:11434/v1/chat/completions
# FELIX_PROVIDER_MODEL=local-model-name

# Optional token for a protected remote endpoint. Never bake this into the ISO.
# FELIX_PROVIDER_TOKEN=
