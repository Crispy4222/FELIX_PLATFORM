#!/bin/sh
set -eu

REGISTRY=/etc/felix/doors.json

usage() {
  echo "Usage: felix-door list | open <door> | url <felix://open/door> | think <intent>"
}

open_door() {
  door="${1:-}"
  if ! jq -e --arg door "$door" '.doors[$door] != null' "$REGISTRY" >/dev/null; then
    echo "Unknown or unregistered door: ${door:-<missing>}" >&2
    exit 2
  fi

  case "$door" in
    hallway) nohup /usr/local/bin/felix-hallway-launch >/tmp/felix-hallway.log 2>&1 & ;;
    files) nohup thunar >/tmp/felix-files.log 2>&1 & ;;
    terminal) nohup xfce4-terminal >/tmp/felix-terminal.log 2>&1 & ;;
    browser) nohup firefox-esr >/tmp/felix-browser.log 2>&1 & ;;
    network) nohup nm-connection-editor >/tmp/felix-network.log 2>&1 & ;;
    settings) nohup xfce4-settings-manager >/tmp/felix-settings.log 2>&1 & ;;
    logs) nohup xfce4-terminal --command="journalctl -f -u felix-core.service" >/tmp/felix-logs.log 2>&1 & ;;
    *) echo "Door is registered but has no local launcher: $door" >&2; exit 3 ;;
  esac

  logger -t felix-door "operator opened allowlisted door=$door"
}

case "${1:-}" in
  list)
    jq -r '.doors | to_entries[] | "\(.key)\t\(.value.label)\t\(.value.purpose)"' "$REGISTRY"
    ;;
  open)
    open_door "${2:-}"
    ;;
  url)
    uri="${2:-}"
    door="${uri#felix://open/}"
    if [ "$door" = "$uri" ] || [ -z "$door" ]; then
      echo "Invalid FELIX door URI: ${uri:-<missing>}" >&2
      exit 2
    fi
    open_door "$door"
    ;;
  think)
    shift
    [ "$#" -gt 0 ] || { usage; exit 2; }
    exec felixctl think "$*"
    ;;
  *) usage; exit 2 ;;
esac
