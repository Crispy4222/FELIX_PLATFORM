#!/bin/sh
set -eu

URL="http://127.0.0.1:8080"

for attempt in $(seq 1 30); do
  if curl --silent --fail --max-time 1 "$URL" >/dev/null; then
    exec firefox-esr --kiosk --private-window "$URL"
  fi
  sleep 1
done

exec xfce4-terminal --title="FELIX recovery" --command="sh -lc 'echo FELIX Hallway did not start.; echo Run: sudo systemctl status felix-hallway; exec sh'"
